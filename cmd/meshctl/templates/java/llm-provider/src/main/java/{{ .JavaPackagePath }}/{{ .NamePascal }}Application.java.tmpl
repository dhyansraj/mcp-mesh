    capability = "llm",
    tags = {{ "{" }}{{ if .Tags }}{{ range $i, $t := .Tags }}{{ if $i }}, {{ end }}"{{ $t }}"{{ end }}{{ else }}{{ range $i, $t := providerTags $model }}{{ if $i }}, {{ end }}"{{ $t }}"{{ end }}{{ end }}{{ "}" }},
